# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.log
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript / tooling caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo/
.cache/

# editor / local IDE
.cursor/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# OS / temp
*.swp
*.swo
*~

# package manager leftovers
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# build / export artifacts
*.zip
*.tgz
deliverables/**/*.zip
deliverables/screenshots/
**/homepage-*-debug*.png
**/_dbg_*.png
