# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
coverage/

# next.js / compile output
.next/
out/
dist/
build/
storybook-static/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.log
*.local

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript / tooling caches
*.tsbuildinfo
next-env.d.ts
.eslintcache
.turbo/
.cache/
.parcel-cache/

# generated source maps
*.map

# editor / local IDE
.cursor/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# OS / temp
*.swp
*.swo
*~

# package manager leftovers
package-lock.json.bak

# build / export artifacts
*.zip
*.tgz
*.tar.gz
*.tar
*.rar
.next/
out/
dist/
build/
coverage/
storybook-static/
tsconfig.tsbuildinfo
next-env.d.ts

# local dumps and delivery packages
backups/
deliverables/

# debug screenshots
**/homepage-*-debug*.png
**/_dbg_*.png
